# Copy this file to .env. Start with mock, or set COMPUTE_PROVIDER=openstack after filling in all required values.
COMPUTE_PROVIDER=mock
PROVISIONING_TIMEOUT_SECONDS=180

# Keystone v3 authentication and project scope
OPENSTACK_AUTH_URL=https://openstack.example.edu:5000/v3
OPENSTACK_USERNAME=
OPENSTACK_PASSWORD=
OPENSTACK_USER_DOMAIN=Default
OPENSTACK_PROJECT_NAME=
OPENSTACK_PROJECT_ID=
OPENSTACK_PROJECT_DOMAIN=Default
OPENSTACK_REGION=RegionOne
OPENSTACK_INTERFACE=public

# Nova server parameters
OPENSTACK_NETWORK_ID=
OPENSTACK_IMAGE_ID=
OPENSTACK_KEY_NAME=
OPENSTACK_FLAVOR_ID_SMALL=
OPENSTACK_FLAVOR_ID_MEDIUM=
OPENSTACK_FLAVOR_ID_LARGE=
OPENSTACK_FLAVOR_ID_COMPUTE=
OPENSTACK_FLAVOR_ID_MEMORY=

# OpenStack image/flavor/network values must be IDs visible in the scoped project.
# Password and IDs belong in the local .env only; do not commit that file.
